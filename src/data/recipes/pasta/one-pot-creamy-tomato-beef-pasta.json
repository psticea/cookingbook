  "instructions": {
    "ro": [
      "Încălzește uleiul la foc mare într-o oală mare și călește usturoiul și ceapa 1-2 minute.",
      "Adaugă carnea și gătește, fărâmițând-o, până nu mai e roșie. Adaugă ierburile (30 sec), apoi pasta de roșii (1 min).",
      "Adaugă roșiile, supa, sarea, piperul și chili, amestecă, apoi adaugă pastele.",
      "Adu la fierbere și gătește 15 minute, amestecând des, până pastele sunt aproape gata.",
      "Adaugă smântâna și mai fierbe 1-2 minute. Sosul trebuie să rămână zemos.",
      "Amestecă bine și servește cu parmezan și pătrunjel."
    ],
    "en": [
      "Heat oil on high in a large pot and sauté garlic and onion for 1-2 minutes.",
      "Add beef and cook, breaking it up, until no longer red. Add herbs (30 sec), then tomato paste (1 min).",
      "Add tomatoes, stock, salt, pepper and chili flakes, stir, then add pasta.",
      "Bring to a simmer and cook 15 minutes, stirring often, until pasta is almost done.",
      "Stir in cream and simmer 1-2 minutes more. It should still be saucy.",
      "Stir well and serve with parmesan and parsley."
    ]
  },
